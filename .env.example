# --- you ---
USER_PHONE=+1XXXXXXXXXX         # E.164; the only sender BidBy acts on (also list it in ALLOWED_DIAL_NUMBERS)

# --- OpenClaw (Gateway on 127.0.0.1:18789) ---
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
AGENT_BACKEND=openclaw          # openclaw | direct (fallback, spec 01)

# --- Photon Spectrum (Stable; iMessage texting only, no calls) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
MESSAGING_MODE=imessage         # imessage | log (smoke tests)

# --- ElevenLabs (calls go out through a Twilio number imported into ElevenLabs) ---
# Twilio Account SID / Auth Token are entered only in the ElevenLabs dashboard, never here.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=     # id of the imported Twilio number in ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
BIDBY_TOOL_SECRET=              # long random string; also set as a secret header on the 3 ElevenLabs tools
VOICE_PROVIDER=twilio           # twilio | sip
VOICE_MODE=live                 # live | mock | dashboard
ALLOWED_DIAL_NUMBERS=           # comma-separated E.164; required when VOICE_MODE=live

# --- core ---
PORT=8787
